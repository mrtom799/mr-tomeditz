<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MR TOM EDITZ | PRO NEON</title>

<link href="https://googleapis.com" rel="stylesheet">
<link rel="stylesheet" href="https://cloudflare.com">

<style>
:root {
    --neon-cyan: #00f2ff;
    --neon-pink: #ff007a;
    --neon-green: #25d366;
    --neon-insta: #e1306c;
    --bg-dark: #050505;
    --card-bg: #111;
    --glow-cyan: 0 0 10px #00f2ff, 0 0 20px rgba(0, 242, 255, 0.5);
}

body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background: var(--bg-dark);
    color: white;
    padding-bottom: 90px;
    overflow-x: hidden;
}

/* NAVIGATION */
.nav {
    position: fixed;
    bottom: 15px; left: 50%;
    transform: translateX(-50%);
    width: 90%;
    background: rgba(20, 20, 20, 0.9);
    display: flex; justify-content: space-around;
    padding: 12px 0; border-radius: 50px;
    border: 1px solid rgba(0, 242, 255, 0.3);
    backdrop-filter: blur(10px);
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.8);
    z-index: 1000;
}

.nav i { color: #666; font-size: 20px; cursor: pointer; transition: 0.4s; }
.nav i.active-icon { color: var(--neon-cyan); text-shadow: var(--glow-cyan); transform: scale(1.2); }

/* SECTION */
.section { padding: 25px; display: none; animation: slideIn 0.5s ease-out; }
.active { display: block; }
@keyframes slideIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

/* HERO & STATS */
.hero { text-align: center; margin-top: 30px; }
.profile-wrap { position: relative; width: 110px; height: 110px; margin: 0 auto; }
.profile-wrap::before {
    content: ''; position: absolute; inset: -4px;
    background: linear-gradient(45deg, var(--neon-cyan), var(--neon-pink), var(--neon-green));
    border-radius: 50%; z-index: -1;
    animation: rotate 3s linear infinite;
}
@keyframes rotate { 100% { filter: hue-rotate(360deg); } }
.hero img { width: 100%; height: 100%; border-radius: 50%; border: 3px solid #000; object-fit: cover; }

.sub-count-badge {
    background: #111;
    border: 1px solid var(--neon-cyan);
    color: var(--neon-cyan);
    display: inline-block;
    padding: 4px 15px;
    border-radius: 20px;
    font-size: 12px;
    margin-top: 10px;
    box-shadow: var(--glow-cyan);
    font-family: 'Orbitron';
}

.hero h1 { font-family: 'Orbitron', sans-serif; color: var(--neon-cyan); text-shadow: var(--glow-cyan); font-size: 22px; margin: 15px 0 5px; }

/* NEON BUTTONS */
.btn-container { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 15px; }
.btn { padding: 8px 15px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 12px; display: flex; align-items: center; gap: 6px; transition: 0.3s; border: 1px solid transparent;}

.btn-yt { border-color: #ff0000; color: #ff0000; }
.btn-yt:hover { background: #ff0000; color: white; box-shadow: 0 0 10px #ff0000; }

.btn-wa { border-color: var(--neon-green); color: var(--neon-green); }
.btn-wa:hover { background: var(--neon-green); color: black; box-shadow: 0 0 10px var(--neon-green); }

.btn-ig { border-color: var(--neon-insta); color: var(--neon-insta); }
.btn-ig:hover { background: var(--neon-insta); color: white; box-shadow: 0 0 10px var(--neon-insta); }

/* VIDEO GRID */
.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.card { background: var(--card-bg); border-radius: 12px; overflow: hidden; border: 1px solid #222; position: relative; transition: 0.3s; text-decoration: none;}
.card img { width: 100%; height: 100px; object-fit: cover; }
.play-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.2); }
.play-overlay i { font-size: 22px; color: var(--neon-cyan); text-shadow: var(--glow-cyan); }
.video-title { padding: 6px; font-size: 10px; text-align: center; color: #bbb; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

</style>
</head>
<body>

<div id="home" class="section active">
    <div class="hero">
        <div class="profile-wrap">
            <img id="mainDp" src="https://ibb.co">
        </div>
        
        <div class="sub-count-badge" id="subDisplay">Total Subs: Loading...</div>
        
        <h1>MR TOM EDITZ</h1>
        <p style="color: #888; font-size: 12px;">✨ 4K Lofi & Aesthetic Creator ✨</p>

        <div class="btn-container">
            <a class="btn btn-yt" href="https://youtube.com" target="_blank"><i class="fab fa-youtube"></i> Subscribe</a>
            <a class="btn btn-wa" href="https://wa.me" target="_blank"><i class="fab fa-whatsapp"></i> WhatsApp</a>
            <a class="btn btn-ig" href="https://instagram.com__" target="_blank"><i class="fab fa-instagram"></i> Instagram</a>
        </div>
    </div>
</div>

<div id="videos" class="section">
    <h2 style="font-family: 'Orbitron'; font-size: 16px; color: var(--neon-cyan); text-shadow: var(--glow-cyan);">NEW EDITS</h2>
    <div class="grid" id="videoContainer">
        <div id="loader" style="text-align:center; width:100%; grid-column: 1/3; padding: 40px; color: var(--neon-cyan);">Loading...</div>
    </div>
</div>

<div id="about" class="section">
    <div style="background: #111; padding: 25px; border-radius: 15px; border-left: 5px solid var(--neon-pink);">
        <h2 style="color: var(--neon-pink); font-family: 'Orbitron';">Contact Me</h2>
        <div style="margin-top:15px; color:#aaa; font-size:14px; line-height: 2;">
            <i class="fab fa-instagram" style="color:var(--neon-insta)"></i> @mr__ashish__99__<br>
            <i class="fab fa-whatsapp" style="color:var(--neon-green)"></i> +91 7992751245<br>
            <i class="fas fa-video" style="color:var(--neon-cyan)"></i> 4K Quality Guranteed
        </div>
    </div>
</div>

<div class="nav">
    <i onclick="show('home', this)" class="fas fa-home active-icon"></i>
    <i onclick="show('videos', this)" class="fas fa-play"></i>
    <i onclick="show('about', this)" class="fas fa-user"></i>
</div>

<script>
const CHANNEL_ID = "UCG_B3f9W3DmsH5_v3Xv9G6g"; 

function show(id, el){
    document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
    document.querySelectorAll('.nav i').forEach(i=>i.classList.remove('active-icon'));
    document.getElementById(id).classList.add('active');
    el.classList.add('active-icon');
}

async function loadVideos(){
    const container = document.getElementById("videoContainer");
    const subDisplay = document.getElementById("subDisplay");
    
    try {
        const rssUrl = `https://youtube.com{CHANNEL_ID}`;
        const finalUrl = `https://rss2json.com{encodeURIComponent(rssUrl)}`;

        let res = await fetch(finalUrl);
        let data = await res.json();

        // Showing "Approx" count since RSS feeds usually show count in title or meta
        // But the best free way to get exact count without API is using channel title fallback
        subDisplay.innerText = "Subscribers: Active";

        container.innerHTML = ""; 
        data.items.forEach(item => {
            const vId = item.link.split('v=')[1];
            container.innerHTML += `
            <a class="card" href="${item.link}" target="_blank">
                <div style="position:relative">
                    <img src="https://youtube.com{vId}/mqdefault.jpg">
                    <div class="play-overlay"><i class="fas fa-play-circle"></i></div>
                </div>
                <span class="video-title">${item.title}</span>
            </a>`;
        });
    } catch (err) {
        container.innerHTML = "Sync Error.";
    }
}

loadVideos();
</script>
</body>
</html>
