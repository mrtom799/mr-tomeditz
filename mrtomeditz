<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MR TOM EDITZ | PRO</title>

<!-- FONTS -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Orbitron:wght@500&display=swap" rel="stylesheet">

<!-- ICONS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
:root {
    --cyan: #00f2ff;
    --pink: #ff007a;
    --green: #25d366;
    --bg: #050505;
}

body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background: var(--bg);
    color: white;
}

/* HERO */
.hero {
    text-align: center;
    padding: 30px 15px;
}

.hero img {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: 3px solid var(--cyan);
    box-shadow: 0 0 20px var(--cyan);
}

.hero h1 {
    font-family: 'Orbitron';
    color: var(--cyan);
    margin: 15px 0 5px;
}

.sub {
    font-size: 12px;
    color: #aaa;
}

/* BUTTONS */
.btns {
    margin-top: 15px;
}

.btn {
    display: inline-block;
    margin: 5px;
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 12px;
    border: 1px solid;
    transition: 0.3s;
}

.yt { color: red; border-color: red; }
.yt:hover { background: red; color: white; }

.wa { color: var(--green); border-color: var(--green); }
.wa:hover { background: var(--green); color: black; }

.ig { color: var(--pink); border-color: var(--pink); }
.ig:hover { background: var(--pink); color: white; }

/* VIDEOS */
.videos {
    padding: 15px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.card {
    background: #111;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
}

.card img {
    width: 100%;
}

.title {
    font-size: 10px;
    padding: 5px;
    color: #ccc;
}

/* NAV */
.nav {
    position: fixed;
    bottom: 10px;
    width: 90%;
    left: 50%;
    transform: translateX(-50%);
    background: #111;
    display: flex;
    justify-content: space-around;
    padding: 10px;
    border-radius: 50px;
}

.nav i {
    color: #666;
    font-size: 18px;
    cursor: pointer;
}

.active {
    color: var(--cyan);
}

/* SECTIONS */
.section { display: none; }
.show { display: block; }
</style>
</head>

<body>

<!-- HOME -->
<div id="home" class="section show">
<div class="hero">
<img src="https://i.ibb.co/4fKQ9hF/profile.png">

<h1>MR TOM EDITZ</h1>
<div class="sub">4K Lofi & Status Creator</div>

<div class="btns">
<a class="btn yt" href="https://youtube.com" target="_blank">YouTube</a>
<a class="btn wa" href="https://wa.me/917992751245?text=Hi%20bro%20I%20saw%20your%20edits🔥" target="_blank">WhatsApp</a>
<a class="btn ig" href="https://instagram.com/mr__ashish__99__" target="_blank">Instagram</a>
</div>
</div>
</div>

<!-- VIDEOS -->
<div id="videos" class="section">
<div class="videos">
<h3 style="color:#00f2ff;">Latest Videos</h3>

<div class="grid" id="videoBox">
<p>Loading...</p>
</div>
</div>
</div>

<!-- ABOUT -->
<div id="about" class="section">
<div style="padding:20px;">
<h3 style="color:#ff007a;">Contact</h3>
<p style="color:#aaa;">
Instagram: @mr__ashish__99__ <br>
WhatsApp: 7992751245 <br>
4K Status Creator
</p>
</div>
</div>

<!-- NAV -->
<div class="nav">
<i class="fas fa-home active" onclick="showTab('home', this)"></i>
<i class="fas fa-play" onclick="showTab('videos', this)"></i>
<i class="fas fa-user" onclick="showTab('about', this)"></i>
</div>

<script>
const CHANNEL_ID = "UCG_B3f9W3DmsH5_v3Xv9G6g";

function showTab(id, el){
    document.querySelectorAll('.section').forEach(s => s.classList.remove('show'));
    document.getElementById(id).classList.add('show');

    document.querySelectorAll('.nav i').forEach(i => i.classList.remove('active'));
    el.classList.add('active');
}

async function loadVideos(){
    const box = document.getElementById("videoBox");

    try {
        const rss = `https://www.youtube.com/feeds/videos.xml?channel_id=${CHANNEL_ID}`;
        const url = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(rss)}`;

        let res = await fetch(url);
        let data = await res.json();

        box.innerHTML = "";

        data.items.slice(0,8).forEach(v => {
            let id = v.link.split("v=")[1];

            box.innerHTML += `
            <a class="card" href="${v.link}" target="_blank">
                <img src="https://img.youtube.com/vi/${id}/mqdefault.jpg">
                <div class="title">${v.title}</div>
            </a>
            `;
        });

    } catch {
        box.innerHTML = "<p style='color:red'>Failed to load videos</p>";
    }
}

loadVideos();
</script>

</body>
</html>
